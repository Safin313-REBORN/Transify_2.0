# ===================================================================
# Transify Multi-Engine Environment Configuration
# ===================================================================

# Braille Confidence Threshold:
# If model confidence >= 0.98 (98%), application uses local custom-trained model.
# If model confidence < 0.98 (< 98%), application automatically shifts to MCP Server / ChatGPT.
BRAILLE_CONFIDENCE_THRESHOLD=0.98

# External Chatbot / MCP Integration (OpenAI ChatGPT)
# Provide your OpenAI API key here to activate live ChatGPT (GPT-4o / GPT-4o-mini) Vision:
OPENAI_API_KEY=
CHATGPT_MODEL=gpt-4o-mini

# Alternative: Google Gemini API Key
GEMINI_API_KEY=

# Alternative: Custom MCP Server Endpoint URL
MCP_SERVER_URL=
